[Unit]
Description=CubeSat - quiosque na tela do Raspberry (dashboard + Node-RED)
After=systemd-user-sessions.service nodered.service
Wants=nodered.service
Conflicts=getty@tty1.service ecodisplay.service

[Service]
Type=simple
User=pi
PAMName=cubesat-kiosk
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty-fail
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty1
UtmpMode=user
Environment=XDG_SESSION_TYPE=wayland
ExecStart=/usr/bin/labwc -C /home/pi/cubesat-kiosk/labwc
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
